#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --debian-installer live \
  --archive-areas "main contrib non-free-firmware" \
  --apt-recommends false \
  --bootloaders "syslinux grub-efi" \
  --bootappend-live "boot=live components quiet splash username=arkovia hostname=arkovia" \
  --image-name "arkovia-os-developer-preview" \
  --iso-application "Arkovia OS Developer Preview" \
  --iso-publisher "Arkovia OS Project" \
  --iso-volume "ARKOVIA_OS" \
  "${@}"
