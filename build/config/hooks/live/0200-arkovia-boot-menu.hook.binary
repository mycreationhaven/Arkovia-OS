#!/bin/sh
set -eu

for config in binary/isolinux/*.cfg binary/boot/grub/*.cfg binary/EFI/boot/*.cfg; do
  [ -f "$config" ] || continue
  sed -i \
    -e 's/Debian GNU\/Linux/Arkovia OS/g' \
    -e 's/Debian Live/Arkovia OS Live/g' \
    -e 's/Debian Installer/Arkovia OS Installer/g' \
    -e 's/Debian/Arkovia OS/g' \
    -e 's/splash\.svg/arkovia-background.png/g' \
    "$config"
done

if [ -d binary/isolinux ]; then
  cp chroot/usr/share/plymouth/themes/arkovia/background.png \
    binary/isolinux/arkovia-background.png
fi

if [ -d binary/boot/grub ]; then
  cp chroot/usr/share/plymouth/themes/arkovia/background.png \
    binary/boot/grub/arkovia-background.png
  for config in binary/boot/grub/*.cfg; do
    [ -f "$config" ] || continue
    sed -i '1i insmod png\nbackground_image /boot/grub/arkovia-background.png' "$config"
  done
fi

# A visible upstream name in a boot menu is a release-blocking branding bug.
remaining_debian_labels=$(
  find binary/isolinux binary/boot/grub binary/EFI/boot \
    -type f -name '*.cfg' -exec grep -Il 'Debian' {} + 2>/dev/null || true
)
if [ -n "$remaining_debian_labels" ]; then
  echo "Arkovia branding check failed; Debian remains in:" >&2
  echo "$remaining_debian_labels" >&2
  exit 1
fi
